{
  "name": "webpos",
  "version": "0.1.0",
  "private": true,
  "description": "HelloPos — Caisse SaaS pour fleuristes et commerces végétaux (certification-ready FR)",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:lan": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "vercel-build": "npm run db:migrate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:resync": "tsx scripts/migrate-resync.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "user:test": "tsx scripts/create-test-user.ts",
    "grant:admin": "tsx scripts/grant-admin.ts",
    "create:super-admin": "tsx scripts/create-super-admin.ts",
    "reset:password": "tsx scripts/reset-password.ts",
    "list:users": "tsx scripts/list-users.ts",
    "revoke:sessions": "tsx scripts/revoke-sessions.ts",
    "fiscal:verify": "tsx scripts/verify-fiscal-chain.ts",
    "stock:backfill": "tsx scripts/backfill-stock-movements.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "bcryptjs": "2.4.3",
    "bwip-js": "^4.11.1",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.6.3",
    "jose": "5.6.3",
    "next": "14.2.5",
    "passkit-generator": "^3.5.7",
    "pdfkit": "0.15.0",
    "pg": "8.12.0",
    "pureimage": "^0.4.20",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "star-prnt-encoder": "^3.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.10",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "0.13.4",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "jsdom": "^25.0.1",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
