# =========================================================================
# HelloPos — variables d'environnement de production (Vercel + Neon)
# =========================================================================
# À configurer dans Vercel : Settings → Environment Variables.
# Toutes ces variables doivent être actives pour les 3 environnements
# (Production, Preview, Development) sauf indication contraire.

# -------------------------------------------------------------------------
# Base de données Postgres (Neon)
# -------------------------------------------------------------------------
# 1. Crée un projet sur https://neon.tech (région Frankfurt)
# 2. Dans le dashboard : Connection Details → "Pooled connection" (IMPORTANT
#    sur Vercel serverless, sinon trop de connexions ouvertes)
# 3. Copie la chaîne complète : postgresql://user:pwd@ep-xxx-pooler...
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/webpos?sslmode=require

# -------------------------------------------------------------------------
# Secrets cryptographiques (256 bits hex chacun)
# -------------------------------------------------------------------------
# Génère-les une fois pour toutes avec :  openssl rand -hex 32
# JAMAIS deux fois la même valeur, JAMAIS la même qu'en dev.
# Si tu perds SESSION_SECRET : tous les utilisateurs sont déconnectés.
# Si tu perds FISCAL_SIGNING_KEY : impossible de vérifier l'intégrité des
# anciens événements fiscaux — à conserver précieusement.
SESSION_SECRET=64-caractères-hex-aléatoires-générés-avec-openssl
FISCAL_SIGNING_KEY=64-caractères-hex-aléatoires-générés-avec-openssl

# -------------------------------------------------------------------------
# Configuration applicative (toutes optionnelles)
# -------------------------------------------------------------------------
# Durée d'une session utilisateur (minutes). Défaut 480 (8 h).
SESSION_TTL_MINUTES=480
