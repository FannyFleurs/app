{
  "name": "florea-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Florea — Caisse SaaS pour fleuristes et commerces végétaux (certification-ready FR)",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:lan": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "user:test": "tsx scripts/create-test-user.ts",
    "grant:admin": "tsx scripts/grant-admin.ts",
    "create:super-admin": "tsx scripts/create-super-admin.ts",
    "reset:password": "tsx scripts/reset-password.ts",
    "list:users": "tsx scripts/list-users.ts",
    "fiscal:verify": "tsx scripts/verify-fiscal-chain.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "bcryptjs": "2.4.3",
    "bwip-js": "^4.11.1",
    "clsx": "2.1.1",
    "iconv-lite": "^0.6.3",
    "jose": "5.6.3",
    "next": "14.2.5",
    "pdfkit": "0.15.0",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.10",
    "@types/pdfkit": "0.13.4",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
