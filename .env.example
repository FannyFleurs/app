# HelloPos — variables d'environnement (à copier en .env.local)

# Postgres
DATABASE_URL=postgres://webpos:webpos@localhost:5432/webpos

# Clé maître pour signature des événements fiscaux (256 bits hex).
# Générer avec : openssl rand -hex 32
FISCAL_SIGNING_KEY=change-me-to-a-real-256-bit-hex-secret

# Secret de session JWT (256 bits hex).
# Générer avec : openssl rand -hex 32
SESSION_SECRET=change-me-to-a-real-256-bit-hex-secret

# Clé maître de chiffrement des secrets sensibles stockés en base (comptes
# Stripe par boutique notamment) — 256 bits hex. Générer avec :
#   openssl rand -hex 32
# ABSENTE : les secrets restent stockés/lus en clair, comme avant (aucune
# régression). Une fois PRÉSENTE : chaque nouvelle sauvegarde d'un secret
# est automatiquement chiffrée ; les valeurs déjà en clair restent lisibles
# (migration progressive, pas de script à lancer). Voir
# docs/architecture-multi-store-stripe.md pour l'ordre de déploiement.
# Ne jamais changer cette valeur une fois des secrets chiffrés avec elle
# (ils deviendraient indéchiffrables) — la faire tourner nécessite de
# déchiffrer puis rechiffrer explicitement chaque secret.
SECRETS_ENCRYPTION_KEY=change-me-to-a-real-256-bit-hex-secret

# Durée de session (minutes)
SESSION_TTL_MINUTES=43200

# Verrouillage caisse après inactivité (minutes, 0 = désactivé)
REGISTER_LOCK_MINUTES=10

# Émetteur des tickets/factures (peut être surchargé par boutique en BDD)
APP_PUBLIC_NAME=HelloPos
